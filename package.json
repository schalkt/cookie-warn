{
    "name": "cookie-warn",
    "version": "3.2.23",
    "description": "EU cookie warn",
    "homepage": "https://projects.schalk.hu/cookie-warn/demo/index.html",
    "repository": {
        "type": "git",
        "url": "https://github.com/schalkt/cookie-warn.git"
    },
    "keywords": [
        "cookie",
        "warning",
        "europe",
        "law",
        "gdpr"
    ],
    "author": "Tamas Schalk (https://github.com/schalkt)",
    "license": "MIT",
    "main": "index.js",
    "scripts": {
        "dev": "npm run build:dev",
        "build:dev": "webpack --mode development",
        "build:prod": "webpack --mode production",
        "watch": "webpack --watch --mode development",
        "prod": "npm run build:prod",
        "init": "npm prune && npm update && npm audit fix && npm run build:dev",
        "release": "npm --no-git-tag-version version patch && npm run build:prod"
    },
    "devDependencies": {
        "webpack": "^5.102.1",
        "webpack-cli": "^6.0.1"
    }
}
